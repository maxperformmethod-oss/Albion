---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyCallBar from '../components/layout/StickyCallBar.astro';
import {
  LOCALES,
  alternatesFor,
  getContent,
  getLocale,
  routeKeyOf,
} from '../data/i18n.ts';
import { FEATURES } from '../data/business.ts';
import { buildPawnShopSchema } from '../lib/schema.ts';

/**
 * Meta sa rieši tu cez props — žiadny src/lib/seo.ts (BRIEF §12).
 */
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Sticky call bar potrebuje `#hero-sentinel`, takže len na homepage. */
  stickyCallBar?: boolean;
  /** JSON-LD prevádzky. Na 404 nedáva zmysel. */
  schema?: boolean;
  /** Preload hero obrazu — len tam, kde hero naozaj je. */
  preloadHero?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const content = getContent(Astro.currentLocale);

const {
  title = content.meta.title,
  description = content.meta.description,
  noindex = false,
  stickyCallBar = false,
  schema = true,
  preloadHero = false,
} = Astro.props;

/*
  JSON-LD je len na slovenskej verzii. `name` a `address` sú vo všetkých
  jazykoch rovnaké, takže tri kópie tej istej entity by boli len šum.
*/
const jsonLd = schema && locale === 'sk' ? buildPawnShopSchema() : undefined;

/*
  `hreflang` na každej stránke, `x-default` ukazuje na slovenčinu.
  Alternatívy vedú na **tú istú stránku** v druhom jazyku, nie na domovskú.
*/
const alternates = alternatesFor(routeKeyOf(Astro.url.pathname)).map(
  (alternate) => ({
    hreflang: alternate.hreflang,
    href: new URL(alternate.path, Astro.site).href,
  })
);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const showStickyBar = stickyCallBar && FEATURES.stickyCallBar;
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1A1D22" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={LOCALES[locale].ogLocale} />
    <meta property="og:site_name" content="Albion" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /*
        Hero obraz je LCP prvok. Bez preloadu ho prehliadač objaví až po CSS
        a jeho request sa v meraní queueoval o ~730 ms neskôr. `type` zaistí,
        že si ho nestiahne prehliadač bez podpory AVIF.
      */
      preloadHero && (
        <>
          <link
            rel="preload"
            as="image"
            type="image/avif"
            media="(max-width: 767px)"
            imagesrcset="/images/hero-m-480.avif 480w, /images/hero-m-760.avif 760w"
            imagesizes="(max-width: 767px) 40vw, 100vw"
            fetchpriority="high"
          />
          <link
            rel="preload"
            as="image"
            type="image/avif"
            media="(min-width: 768px)"
            imagesrcset="/images/hero-760.avif 760w, /images/hero-1280.avif 1280w"
            imagesizes="100vw"
            fetchpriority="high"
          />
        </>
      )
    }

    {/* Serif, oba subsety — pokrývajú nadpisy vrátane <h1> (BRIEF §4). */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-latin-ext-wght-normal.woff2"
      crossorigin
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }

    {/* Musí bežať pred prvým vykreslením, inak reveal preblikne. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* Analytics: zámerne nič neinštalované (BRIEF §13). Sem by prišlo. */}
  </head>

  <body class:list={[showStickyBar && 'pb-16 md:pb-0']}>
    <a
      href="#obsah"
      class="focus-visible:bg-gold focus-visible:text-ink-900 sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-70 focus-visible:rounded-sm focus-visible:px-4 focus-visible:py-3"
    >
      {content.a11y.skipLink}
    </a>

    <Header />

    <main id="obsah">
      <slot />
    </main>

    <Footer />

    {showStickyBar && <StickyCallBar />}

    <script>
      /*
        Reveal — jeden observer na celú stránku, každý prvok len raz.

        Zásada: animácia nesmie byť podmienkou čitateľnosti. Predtým sa stávalo,
        že pri scrollovaní ostal pod nadpisom sekcie niekoľko sto pixelov
        prázdna — používateľ to čítal ako rozbitú stránku, nie ako animáciu.
        Preto sú tu tri nezávislé cesty, ako sa obsah odhalí:
          1. čo je pri načítaní vo viewporte, sa odhalí hneď a bez prechodu,
          2. zvyšok odhalí observer, len čo sa prvok objaví (nie v strede),
          3. poistka 1200 ms po `load` odhalí všetko, čo ešte ostalo skryté.
      */
      const revealed = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal]')
      );

      /*
        Stagger max 6 × 40 ms — celá sekcia je hotová do 240 ms.

        Pod 768 px je polovičný a naraz sa animuje menej prvkov: mobilné GPU
        zvládnu menej súčasne a dlhší nábeh tam pôsobí ako čakanie.
      */
      const isNarrow = window.matchMedia('(width < 48rem)').matches;
      const STAGGER = isNarrow ? 20 : 40;
      const MAX_STEPS = isNarrow ? 4 : 6;

      const revealAll = () => {
        revealed.forEach((element) => element.classList.add('is-revealed'));
      };

      if (revealed.length > 0 && 'IntersectionObserver' in window) {
        // 1. Už viditeľné pri načítaní. IntersectionObserver ich síce ohlási,
        //    ale až v ďalšom rámci a s prechodom — tu ich chceme rovno na mieste.
        const pending = revealed.filter((element) => {
          const { top, bottom } = element.getBoundingClientRect();
          const visible = top < window.innerHeight && bottom > 0;
          if (visible) element.classList.add('is-instant', 'is-revealed');
          return !visible;
        });

        const observer = new IntersectionObserver(
          (entries) => {
            // `index` musí ísť cez odhaľované prvky, nie cez celú dávku —
            // v dávke sú aj tie, ktoré práve odchádzajú z viewportu.
            let step = 0;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const element = entry.target as HTMLElement;
              observer.unobserve(element);
              window.setTimeout(
                () => element.classList.add('is-revealed'),
                Math.min(step++, MAX_STEPS) * STAGGER
              );
            });
          },
          {
            // Prvok sa odhalí, keď sa objaví, nie keď je v strede. `threshold: 0`
            // znamená prvý pixel; spodných -8 % len bráni odhaleniu tesne
            // pod hranou, kde by to používateľ ešte nevidel.
            rootMargin: '0px 0px -8% 0px',
            threshold: 0,
          }
        );

        pending.forEach((element) => observer.observe(element));

        // 3. Poistka. Ak sa čokoľvek pokazí, stránka ostane čitateľná.
        const arm = () => window.setTimeout(revealAll, 1200);
        if (document.readyState === 'complete') arm();
        else window.addEventListener('load', arm, { once: true });
      } else {
        revealAll();
      }
    </script>
  </body>
</html>
