---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBand from '../components/sections/TrustBand.astro';
import WhatWeAccept from '../components/sections/WhatWeAccept.astro';
import PawnOrSell from '../components/sections/PawnOrSell.astro';
import Selling from '../components/sections/Selling.astro';
import Valuation from '../components/sections/Valuation.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import WhyAlbion from '../components/sections/WhyAlbion.astro';
import OwnerNote from '../components/sections/OwnerNote.astro';
import LocationMap from '../components/sections/LocationMap.astro';
import Contact from '../components/sections/Contact.astro';

/*
  Medzi sekciami je ostrá hrana a na predele vlasová zlatá linka — kreslí ju
  `Section.astro`. Gradientové prechody tu boli dve dávky a stále čítali ako
  chyba renderovania, nie ako zámer; rozmazaný pás medzi dvoma farbami nikdy
  nebude vyzerať draho.
*/
---

<BaseLayout stickyCallBar preloadHero>
  <Hero />
  <TrustBand />
  <WhatWeAccept />
  <PawnOrSell />
  <Selling />
  <Valuation />
  <HowItWorks />
  <WhyAlbion />
  <OwnerNote />
  <LocationMap />
  <Contact />
</BaseLayout>
