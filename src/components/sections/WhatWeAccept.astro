---
import Section from '../ui/Section.astro';
import PaperGold from '../ui/PaperGold.astro';
import { getContent } from '../../data/i18n.ts';

const content = getContent(Astro.currentLocale);

const { id, h2, lead, items, outro } = content.whatWeAccept;
---

<Section
  tone="paper"
  id={id}
  labelledby="what-we-accept-title"
  divider={false}
  class="overflow-hidden"
>
  <PaperGold slot="backdrop" word="ZLATO" />

  {/*
    Nadpis vpravo, obsah vľavo. Každá sekcia má inú kompozíciu — po treťom
    opakovaní tej istej stavby oko prestane vnímať a stránka splynie do šablóny.
  */}
  <div class="lg:flex lg:items-start lg:justify-between lg:gap-16">
    <p class="text-lead text-ink-muted mt-6 max-w-[44ch] lg:order-1 lg:mt-2 lg:w-[40%]" data-reveal>
      {lead}
    </p>

    <h2
      id="what-we-accept-title"
      class="font-serif text-h2 max-w-[20ch] lg:order-2 lg:w-[56%] lg:text-right"
      data-reveal
    >
      {h2}
    </h2>
  </div>

  {/*
    Tri stĺpce, nie štyri: v štyroch úzkych stĺpcoch sa názvy lámali na drobné
    riadky a mriežka pôsobila ako zoznam v pätičke. Pri troch sa každá položka
    zmestí na jeden riadok v `--text-h3` a mriežka využije celú šírku kontajnera.
  */}
  {/*
    Index nad položkou. Zoznam sa tým číta ako katalóg, nie ako odrážky —
    je to jeden z mála prvkov, ktorý na svetlej ploche unesie zlatú.
  */}
  <ul class="mt-12 grid grid-cols-1 gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item, index) => (
        <li class="grid-line py-5" data-reveal data-rule-cell>
          <span
            class="font-sans text-eyebrow text-gold-ink block tracking-[0.14em]"
            aria-hidden="true"
            data-numeric
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="font-serif text-h3 mt-2 block">{item}</span>
        </li>
      ))
    }
  </ul>

  <p class="text-ink-muted measure mt-10" data-reveal>{outro}</p>
</Section>
