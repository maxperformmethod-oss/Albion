---
import Section from '../ui/Section.astro';
import PaperGold from '../ui/PaperGold.astro';
import { business, isConfirmed, FEATURES } from '../../data/business.ts';
import { getContent } from '../../data/i18n.ts';

const content = getContent(Astro.currentLocale);

const { id, h2, steps } = content.howItWorks;

// Poznámka o dokladoch sa vykreslí len keď je potvrdená (BRIEF §7/5).
const requiredDocuments = isConfirmed(business.requiredDocuments)
  ? business.requiredDocuments
  : null;
---

<Section
  tone="paper-2"
  id={id}
  labelledby="how-it-works-title"
  class="overflow-hidden"
>
  <PaperGold slot="backdrop" word="DOHODA" wordSide="left" />

  <h2
    id="how-it-works-title"
    class="font-serif text-h2 mx-auto max-w-[24ch] text-center"
    data-reveal
  >
    {h2}
  </h2>

  {
    FEATURES.hooks && (
      <p class="text-lead text-ink-text mx-auto mt-6 max-w-[44ch] text-center" data-reveal>
        {content.hooks.howItWorks}
      </p>
    )
  }

  {/*
    Číslo kroku je veľké a leží za textom, nie nad ním. Nesie rytmus sekcie
    a pritom sa nedá prečítať namiesto obsahu — je to plocha, nie údaj.
  */}
  <ol class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-3">
    {
      steps.map((step, index) => (
        <li class="grid-line relative pt-6" data-reveal data-rule-cell>
          <span class="step-index font-serif text-display" aria-hidden="true">
            {index + 1}
          </span>
          <h3 class="font-serif text-h3 relative">{step.title}</h3>
          <p class="text-ink-muted relative mt-3">{step.text}</p>
        </li>
      ))
    }
  </ol>

  {
    requiredDocuments && (
      <p class="text-ink-muted measure text-small mt-12" data-reveal>
        {requiredDocuments}
      </p>
    )
  }
</Section>

<style>
  .step-index {
    position: absolute;
    top: 0.1em;
    right: 0;
    line-height: 1;
    opacity: 0.12;
    pointer-events: none;
    user-select: none;
    font-variant-numeric: tabular-nums;
  }
</style>
