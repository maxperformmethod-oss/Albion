---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import mapSvg from './map.generated.svg?raw';
import { business, isConfirmed } from '../../data/business.ts';
import { content } from '../../data/content.ts';
import { mapsUrl } from '../../lib/cta.ts';

/**
 * „Kde nás nájdete“ — vlastná axonometrická mapa zo skutočných dát OSM.
 *
 * Žiadny embed Google Máp ani satelitná snímka. Dôvody sa nezmenili:
 * licencia (ich snímky sa dajú použiť len cez ich API a renderer), rozpočet
 * (iframe = third-party skripty a cookies) a vzhľad. Dáta OSM sú otvorené
 * (ODbL), takže z nich smieme vykresliť **vlastnú** mapu — skutočné pôdorysy
 * budov, skutočná geometria ulíc, naše farby, nula runtime requestov.
 * Jediná podmienka je atribúcia, ktorá je pod mapou.
 *
 * SVG generuje `scripts/build-map.mjs` (`npm run map`) a je commitnuté.
 * Build ho nikdy nevolá — pravidlá Overpass to zakazujú.
 *
 * Čo mapa zámerne **neuvádza**: názvy ulíc. OSM na mieste potvrdených
 * súradníc vedie ulicu ako „Mieru“, nie `Kpt. Nálepku` z našej adresy.
 * Písať k nej našu adresu by znamenalo tvrdiť niečo, čo dáta nepodporujú.
 * Adresa je v texte pod mapou — a ten je aj tak jediný záväzný nositeľ údaja.
 */

const { id, h2, cta, map } = content.location;

const postalCity = isConfirmed(business.postalCode)
  ? `${business.postalCode} ${business.city}`
  : business.city;

const street = isConfirmed(business.street) ? business.street : null;
---

<Section tone="ink" id={id} labelledby="location-title">
  <div class="measure">
    <h2 id="location-title" class="font-serif text-h2" data-reveal>{h2}</h2>
  </div>

  {/*
    Pozoruje sa obal, nie cesty v SVG. Prvok s nulovou plochou
    IntersectionObserver nikdy neohlási, a `<path>` bez výplne je presne taký.
  */}
  <figure class="mt-10" data-map>
    <Fragment set:html={mapSvg} />

    <figcaption class="text-bone-muted mt-4 text-[0.8125rem]">
      <a
        href={map.attributionHref}
        rel="noopener"
        class="hover:text-bone transition-fast underline decoration-1 underline-offset-4"
      >
        {map.attribution}
      </a>
    </figcaption>
  </figure>

  <div class="mt-10">
    <p class="font-serif text-h2" data-reveal>
      {street && <span class="block">{street}</span>}
      <span class="block">{postalCity}</span>
    </p>

    <p class="text-lead text-bone-muted mt-4" data-reveal>{map.walk}</p>

    {
      mapsUrl && (
        <div class="mt-6" data-reveal>
          <Button variant="link" href={mapsUrl} icon="map-pin">
            {cta}
          </Button>
        </div>
      )
    }
  </div>
</Section>

<style>
  /*
    Mapa príde ako hotový reťazec cez `set:html`, takže scoping sa na jej prvky
    nedostane — selektory musia byť `:global()`, zakotvené na `[data-map]`.
  */
  [data-map] :global(.map) {
    display: block;
    width: 100%;
    height: auto;
    /* Bez masky by mapa končila ostrým štvorcom, čo vyzerá lacno. */
    mask-image: radial-gradient(ellipse at center, black 55%, transparent 100%);
  }

  [data-map] :global(.wall) {
    fill: var(--color-ink-700);
    stroke: var(--color-hairline-dark);
    stroke-width: 0.5;
  }

  [data-map] :global(.roof) {
    fill: var(--color-ink-800);
    stroke: var(--color-hairline-dark);
    stroke-width: 0.5;
  }

  /* Budova, v ktorej pôdoryse leží potvrdený bod prevádzky. */
  [data-map] :global(.roof-anchor) {
    fill: color-mix(in srgb, var(--color-gold) 22%, transparent);
    stroke: var(--color-gold);
    stroke-width: 1.2;
  }

  [data-map] :global(.street) {
    fill: none;
    stroke: rgba(242, 239, 233, 0.1);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-map] :global(.rail) {
    fill: none;
    stroke: var(--color-bone-muted);
    stroke-opacity: 0.25;
    stroke-width: 2.5;
  }

  [data-map] :global(.route) {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 2.5;
    stroke-dasharray: 8 10;
    stroke-linecap: round;
  }

  [data-map] :global(.dot) {
    fill: var(--color-gold);
  }

  [data-map] :global(.halo),
  [data-map] :global(.pulse) {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1;
  }

  [data-map] :global(.halo) {
    stroke-opacity: 0.45;
  }

  [data-map] :global(.pulse) {
    opacity: 0;
  }

  /*
    Popisy sú `<text>`, nie obrysy — musia ostať v DOM a byť vyhľadateľné.
    Merané voči najsvetlejšiemu podkladu pod nimi, teda voči streche budovy.
  */
  [data-map] :global(.label),
  [data-map] :global(.note) {
    fill: var(--color-bone-muted);
    font-family: var(--font-sans);
    font-size: 20px;
    letter-spacing: 0.02em;
  }

  [data-map] :global(.note) {
    font-size: 17px;
  }

  [data-map] :global(.here-label) {
    fill: var(--color-bone);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 30px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /*
      „Mesto sa postaví“ — celá sekvencia do 1,6 s a raz.
      Počiatočný stav visí na triede `js`: bez JS je mapa rovno hotová,
      nie prázdna.
    */
    :global(.js) [data-map] :global(.street),
    :global(.js) [data-map] :global(.route-mask) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) [data-map] :global(.b) {
      opacity: 0;
      transform: translateY(10px);
    }

    :global(.js) [data-map] :global(.here) {
      opacity: 0;
    }

    :global(.js) [data-map].is-drawn :global(.street) {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 600ms var(--ease-out-quint);
    }

    :global(.js) [data-map].is-drawn :global(.b) {
      opacity: 1;
      transform: none;
      transition:
        opacity 300ms var(--ease-out-quint),
        transform 300ms var(--ease-out-quint);
      /* Vlna ide odzadu dopredu, `--d` je 0–20 → najviac 440 ms. */
      transition-delay: calc(200ms + var(--d, 0) * 12ms);
    }

    :global(.js) [data-map].is-drawn :global(.route-mask) {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 500ms var(--ease-out-quint) 760ms;
    }

    :global(.js) [data-map].is-drawn :global(.here) {
      opacity: 1;
      transition: opacity 260ms var(--ease-out-quint) 1180ms;
    }

    /* Jeden raz, nie slučka. Pulzujúci bod je gýč. */
    :global(.js) [data-map].is-drawn :global(.pulse) {
      transform-box: fill-box;
      transform-origin: center;
      animation: map-pulse 400ms var(--ease-out-quint) 1200ms 1 forwards;
    }

    @keyframes map-pulse {
      from {
        transform: scale(1);
        opacity: 0.6;
      }
      to {
        transform: scale(1.35);
        opacity: 0;
      }
    }
  }
</style>

<script>
  // Pozoruje sa obal figúry, nie cesty — pozri poznámku v šablóne.
  const figure = document.querySelector<HTMLElement>('[data-map]');

  if (figure) {
    const draw = () => figure.classList.add('is-drawn');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            draw();
          });
        },
        { threshold: 0.35 }
      );
      observer.observe(figure);
    } else {
      draw();
    }
  }
</script>
