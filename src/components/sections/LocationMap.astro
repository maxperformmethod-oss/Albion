---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import mapSk from './map.generated.sk.svg?raw';
import mapHu from './map.generated.hu.svg?raw';
import mapEn from './map.generated.en.svg?raw';
import { business, isConfirmed } from '../../data/business.ts';
import { getContent, getLocale } from '../../data/i18n.ts';
import { mapsUrl } from '../../lib/cta.ts';

const content = getContent(Astro.currentLocale);

// Popisy sú súčasťou SVG, preto je vrstva B pre každý jazyk vlastná.
const MAPS = { sk: mapSk, hu: mapHu, en: mapEn };
const mapSvg = MAPS[getLocale(Astro.currentLocale)];

/**
 * „Kde nás nájdete“ — vlastná axonometrická mapa zo skutočných dát OSM.
 *
 * Žiadny embed Google Máp ani satelitná snímka: ich snímky sú licencované,
 * embed je third-party iframe s cookies a screenshot na prémiovom webe vyzerá
 * lacno. Dáta OSM sú otvorené (ODbL), takže z nich smieme vykresliť vlastnú
 * mapu. Jediná podmienka je atribúcia — je pod mapou.
 *
 * ## Dve vrstvy
 *
 * Vrstva A je **zapečený obraz** (`/images/map-*`): podklad, koľajisko, zeleň,
 * vzdialené budovy aj s vrhnutými tieňmi, atmosférický úbytok, vinetáž a zrno.
 * Rozostrené tiene by v inline SVG stáli násobne viac než celý ten obrázok.
 *
 * Vrstva B je **inline SVG** nad ním: cesty, budovy v strede, obe stanice,
 * Albion, trasa a popisy — teda všetko, čo sa animuje alebo nesie informáciu.
 *
 * Obe generuje `npm run map` z jednej projekcie (`scripts/map-projection.mjs`),
 * takže sedia na pixel. Build sa na to nespolieha, obe sú commitnuté.
 *
 * Mapa **nevypisuje názvy ulíc**: OSM v tomto bloku nemá `Kpt. Nálepku`
 * zamapovanú. Adresa je v texte pod mapou, kde je aj tak jediným záväzným
 * nositeľom údaja.
 */

const { id, h2, cta, map } = content.location;

const postalCity = isConfirmed(business.postalCode)
  ? `${business.postalCode} ${business.city}`
  : business.city;

const street = isConfirmed(business.street) ? business.street : null;
---

<Section tone="ink" id={id} labelledby="location-title">
  <div class="measure">
    <h2 id="location-title" class="font-serif text-h2" data-reveal>{h2}</h2>
  </div>

  {/*
    Pozoruje sa obal, nie cesty v SVG. Prvok s nulovou plochou
    IntersectionObserver nikdy neohlási, a `<path>` bez výplne je presne taký.
  */}
  <figure class="mt-10" data-map>
    {/*
      Obe vrstvy sú absolútne, takže výšku drží pomer strán tohto obalu.
      Popis pod mapou musí ostať mimo neho, inak by sa doň zložil navrch.
    */}
    <div class="map-frame">
    <picture>
      <source
        type="image/avif"
        srcset="/images/map-760.avif 760w, /images/map-1600.avif 1600w"
        sizes="(min-width: 1240px) 1136px, 100vw"
      />
      <source
        type="image/webp"
        srcset="/images/map-760.webp 760w, /images/map-1600.webp 1600w"
        sizes="(min-width: 1240px) 1136px, 100vw"
      />
      <img
        src="/images/map-1600.webp"
        width="1600"
        height="933"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="map-base"
      />
    </picture>

    <Fragment set:html={mapSvg} />
    </div>

    <figcaption class="text-bone-muted mt-4 text-[0.8125rem]">
      <a
        href={map.attributionHref}
        rel="noopener"
        class="hover:text-bone transition-fast underline decoration-1 underline-offset-4"
      >
        {map.attribution}
      </a>
    </figcaption>
  </figure>

  <div class="mt-10">
    <p class="font-serif text-h2" data-reveal>
      {street && <span class="block">{street}</span>}
      <span class="block">{postalCity}</span>
    </p>

    <p class="text-lead text-bone-muted mt-4" data-reveal>{map.walk}</p>

    {
      mapsUrl && (
        <div class="mt-6" data-reveal>
          <Button variant="link" href={mapsUrl} icon="map-pin">
            {cta}
          </Button>
        </div>
      )
    }
  </div>
</Section>

<style>
  .map-frame {
    position: relative;
    /* Obe vrstvy majú rovnaký pomer strán — 1200 × 700 z projekcie. */
    aspect-ratio: 1200 / 700;
  }

  .map-base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    Mapa príde ako hotový reťazec cez `set:html`, takže scoping sa na jej prvky
    nedostane — selektory musia byť `:global()`, zakotvené na `[data-map]`.
  */
  [data-map] :global(.map) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
    Vinetáž je jemná a spoločná pre obe vrstvy — mapa nesmie končiť ostrým
    štvorcom, ale ani vyzerať ako kruhový výrez.
  */
  .map-frame > picture,
  [data-map] :global(.map) {
    -webkit-mask-image: radial-gradient(
      ellipse 78% 82% at 50% 50%,
      black 42%,
      rgb(0 0 0 / 0.55) 74%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 78% 82% at 50% 50%,
      black 42%,
      rgb(0 0 0 / 0.55) 74%,
      transparent 100%
    );
  }

  /* --- hmota: tri hodnoty na troch plochách ------------------------------ */

  [data-map] :global(.wd) {
    fill: #1e222b;
  }

  [data-map] :global(.wl) {
    fill: #2a303b;
  }

  [data-map] :global(.rf) {
    fill: #333944;
    stroke: #424a57;
    stroke-width: 0.6;
  }

  /* Budovy okolo Albionu chytajú to isté svetlo. */
  [data-map] :global(.b-n .rf) {
    fill: #3a414d;
  }

  /* Albion: zlatá strecha a zlatý rim light na hranách. */
  [data-map] :global(.rf-a) {
    fill: color-mix(in srgb, var(--color-gold) 24%, transparent);
    stroke: var(--color-gold);
    stroke-width: 1.5;
  }

  [data-map] :global(.b-a .wl),
  [data-map] :global(.b-a .wd) {
    stroke: color-mix(in srgb, var(--color-gold) 55%, transparent);
    stroke-width: 1.2;
  }

  [data-map] :global(.shadows) {
    fill: #000;
    opacity: 0.35;
  }

  /* --- cesty: lem pod cestou je detail, ktorý odlišuje návrh od výstupu -- */

  [data-map] :global(.rc) {
    fill: none;
    stroke: #14171c;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-map] :global(.rr) {
    fill: none;
    stroke: var(--color-bone);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-map] :global(.rr-d) {
    stroke-dasharray: 4 5;
  }

  [data-map] :global(.rail) {
    fill: none;
    stroke: var(--color-bone-muted);
    stroke-opacity: 0.25;
    stroke-width: 2.5;
  }

  [data-map] :global(.route) {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 2.5;
    stroke-dasharray: 8 10;
    stroke-linecap: round;
  }

  /* --- Albion ako ohnisko ------------------------------------------------ */

  [data-map] :global(.dot) {
    fill: var(--color-gold);
  }

  [data-map] :global(.halo),
  [data-map] :global(.pulse) {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1;
  }

  [data-map] :global(.halo) {
    stroke-opacity: 0.45;
  }

  [data-map] :global(.pulse) {
    opacity: 0;
  }

  [data-map] :global(.glow) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* --- popisy ------------------------------------------------------------ */

  /*
    Halo okolo textu. Bez neho sa popis stratí nad budovami — je to jediný
    spôsob, ako udržať čitateľnosť bez toho, aby sme text položili na plochu.
  */
  [data-map] :global(.label),
  [data-map] :global(.here-label),
  [data-map] :global(.note),
  /* Severka musí byť čitateľná — stojí za `.chrome-text`, aby ju prebila. */
  [data-map] :global(.chrome-text.north-label) {
    font-size: 20px;
    font-weight: 600;
    fill-opacity: 0.85;
  }

  [data-map] :global(.north-axis) {
    stroke-width: 2;
    stroke-opacity: 0.75;
  }

  [data-map] :global(.chrome-text) {
    paint-order: stroke;
    stroke: var(--color-ink-900);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  [data-map] :global(.label),
  [data-map] :global(.note) {
    fill: var(--color-bone-muted);
    font-family: var(--font-sans);
    font-size: 19px;
    letter-spacing: 0.02em;
  }

  [data-map] :global(.note) {
    font-size: 16px;
  }

  /* Orientačné body sú o dva stupne menšie než stanice. */
  [data-map] :global(.label-sm) {
    font-size: 15px;
  }

  [data-map] :global(.here-label) {
    fill: var(--color-bone);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 32px;
  }

  /* Mierka a severka — drobné a tlmené, ale hovoria „toto je skutočná mapa“. */
  [data-map] :global(.chrome) {
    fill: none;
    stroke: var(--color-bone-muted);
    stroke-opacity: 0.6;
    stroke-width: 1.4;
  }

  [data-map] :global(.chrome-fill) {
    fill: var(--color-bone-muted);
    fill-opacity: 0.8;
    stroke: none;
  }

  [data-map] :global(.chrome-text) {
    fill: var(--color-bone-muted);
    /* Severka aj mierka boli pri 0,55 nečitateľné — 0,8 ich udrží tlmené, ale prečítateľné. */
    fill-opacity: 0.8;
    stroke-width: 2.5px;
    font-family: var(--font-sans);
    font-size: 16px;
    letter-spacing: 0.04em;
  }

  /* --- animácia ---------------------------------------------------------- */

  @media (prefers-reduced-motion: no-preference) {
    /*
      Celá sekvencia raz, do ~2,5 s. Počiatočný stav visí na triede `js`:
      bez JS je mapa rovno hotová, nie prázdna.

      Fázy sa **prekrývajú**. Predtým medzi nimi boli hluché miesta (budovy
      dosadli na 1312 ms, trasa sa rozbehla až na 1500) a sekvencia sa preto
      čítala ako séria samostatných krokov, nie ako jeden pohyb.

      Druhé pravidlo: naraz sa nesmie prekresľovať priveľa prvkov. Kreslenie
      ciest a nábeh budov sa prekrývajú len krátko, nie celou dĺžkou.
    */
    :global(.js) .map-frame > picture,
    :global(.js) [data-map] :global(.glow) {
      opacity: 0;
    }

    /*
      Kreslia sa **len plné cesty**. Čiarkované si musia nechať svoju
      `stroke-dasharray: 4 5`, inak z nich `1` spraví plnú čiaru.

      Presne to sa dialo: pravidlo bez `:not()` prebilo špecificitou `.rr-d`
      a 41 čiarkovaných ciest sa s JS vykresľovalo ako plné. Čiarkovanie
      prežilo len s vypnutým JS, čiže prakticky nikdy.

      Vedľajší efekt opravy je výkon: prvkov s animovaným `stroke-dashoffset`
      je 43 namiesto 84. Dashovanie sa počíta z geometrie cesty v každom
      snímku, takže je to najdrahšia časť celej sekvencie.
    */
    :global(.js) [data-map] :global(.rr:not(.rr-d)) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) [data-map] :global(.rr-d) {
      opacity: 0;
    }

    :global(.js) [data-map] :global(.b) {
      opacity: 0;
      transform: translateY(10px);
    }

    :global(.js) [data-map] :global(.route-mask) {
      opacity: 0;
    }

    /*
      Rozostrenie na animovanom prvku je na iOS Safari prekreslenie celej
      vrstvy v každom snímku. Tiene sa preto fadeujú len od 768 px vyššie;
      na mobile sú rovno na mieste a nikto to nepostrehne.
    */
    @media (width >= 48rem) {
      :global(.js) [data-map] :global(.shadows) {
        opacity: 0;
      }

      :global(.js) [data-map].is-drawn :global(.shadows) {
        opacity: 0.35;
        transition: opacity 320ms var(--ease-out-quint) 860ms;
      }
    }

    :global(.js) [data-map] :global(.here) {
      opacity: 0;
    }

    :global(.js) [data-map].is-drawn .map-frame > picture {
      opacity: 1;
      transition: opacity 500ms var(--ease-out-quint);
    }

    :global(.js) [data-map].is-drawn :global(.rr:not(.rr-d)) {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 720ms var(--ease-out-quint) 180ms;
    }

    /*
      Čiarkované cesty sa nekreslia, len nabehnú — sú to vedľajšie ulice
      a nemajú si pýtať rovnakú pozornosť ako hlavný ťah.
    */
    :global(.js) [data-map].is-drawn :global(.rr-d) {
      opacity: 1;
      transition: opacity 460ms var(--ease-out-quint) 380ms;
    }

    /*
      Ľahký prestrel — budova sa o kúsok prehupne a sadne. Vlna ide odzadu
      dopredu, `--d` je 0–24, teda najviac 168 ms oneskorenia.

      Štart je na 620 ms, nie na 700: cesty dovtedy dokreslia väčšinu svojej
      dráhy, takže sa prekrývajú len krátko a nie je to vidieť na plynulosti.
      Posun je 10 px namiesto 14 — menšia prekreslovaná plocha pri rovnakom
      dojme.
    */
    :global(.js) [data-map].is-drawn :global(.b) {
      opacity: 1;
      transform: none;
      transition:
        opacity 320ms var(--ease-out-quint),
        transform 420ms cubic-bezier(0.33, 1.15, 0.62, 1);
      transition-delay: calc(620ms + var(--d, 0) * 7ms);
    }

    :global(.js) [data-map].is-drawn :global(.route-mask) {
      opacity: 1;
      stroke-dashoffset: 0;
      transition:
        opacity 1ms 1000ms,
        stroke-dashoffset 560ms var(--ease-out-quint) 1000ms;
    }

    :global(.js) [data-map].is-drawn :global(.glow) {
      opacity: 1;
      transition: opacity 600ms var(--ease-out-quint) 1120ms;
    }

    :global(.js) [data-map].is-drawn :global(.here) {
      opacity: 1;
      transition: opacity 260ms var(--ease-out-quint) 1300ms;
    }

    :global(.js) [data-map].is-drawn :global(.pulse) {
      transform-box: fill-box;
      transform-origin: center;
      animation: map-pulse 420ms var(--ease-out-quint) 1340ms 1 forwards;
    }

    /*
      Pod 768 px je celá sekvencia kratšia (~1,5 s namiesto ~2,5 s) a stagger
      polovičný. Na malej ploche pôsobí dlhá animácia ako čakanie a mobilné
      GPU zvládnu naraz menej prvkov.
    */
    @media (width < 48rem) {
      :global(.js) [data-map].is-drawn :global(.rr:not(.rr-d)) {
        transition-duration: 440ms;
        transition-delay: 120ms;
      }

      :global(.js) [data-map].is-drawn :global(.rr-d) {
        transition-duration: 300ms;
        transition-delay: 240ms;
      }

      :global(.js) [data-map].is-drawn :global(.b) {
        transition-duration: 220ms, 280ms;
        transition-delay: calc(400ms + var(--d, 0) * 4ms);
      }

      :global(.js) [data-map].is-drawn :global(.route-mask) {
        transition:
          opacity 1ms 640ms,
          stroke-dashoffset 340ms var(--ease-out-quint) 640ms;
      }

      :global(.js) [data-map].is-drawn :global(.glow) {
        transition-delay: 720ms;
      }

      :global(.js) [data-map].is-drawn :global(.here) {
        transition-delay: 860ms;
      }

      :global(.js) [data-map].is-drawn :global(.pulse) {
        animation-delay: 890ms;
      }
    }

    /*
      Po dokreslení prejde po trase raz svetlejší zlatý tón — je to ten moment,
      ktorý oku povie „takto sa tam dostaneš“. Jeden prechod, nie slučka.
      Začína ešte počas dokresľovania trasy, aby na ňu plynulo nadviazal.
    */
    :global(.js) [data-map].is-drawn :global(.route) {
      animation: route-sheen 800ms var(--ease-out-quint) 1700ms 1 both;
    }

    @keyframes route-sheen {
      0% {
        stroke: var(--color-gold);
      }
      45% {
        stroke: var(--color-gold-hover);
      }
      100% {
        stroke: var(--color-gold);
      }
    }

    /* Budova Albionu: po dosadnutí jednorazovo zosilnie žiara a vráti sa. */
    :global(.js) [data-map].is-drawn :global(.glow) {
      animation: glow-pulse 700ms var(--ease-out-quint) 1760ms 1 both;
    }

    @keyframes glow-pulse {
      0% {
        opacity: 1;
      }
      40% {
        opacity: 1;
        transform: scale(1.4);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    /*
      Popisy nabehnú ku koncu, po 60 ms za sebou:
      Železničná stanica → Autobusová stanica → Albion.
    */
    :global(.js) [data-map] :global(.label),
    :global(.js) [data-map] :global(.here-label) {
      opacity: 0;
      transform: translateY(4px);
    }

    :global(.js) [data-map].is-drawn :global(.label),
    :global(.js) [data-map].is-drawn :global(.here-label) {
      opacity: 1;
      transform: none;
      transition:
        opacity 300ms var(--ease-out-quint),
        transform 300ms var(--ease-out-quint);
    }

    :global(.js) [data-map].is-drawn :global(.label) {
      transition-delay: 1500ms;
    }

    :global(.js) [data-map].is-drawn :global(.label) + :global(.label) {
      transition-delay: 1560ms;
    }

    :global(.js) [data-map].is-drawn :global(.here-label) {
      transition-delay: 1620ms;
    }

    @media (width < 48rem) {
      :global(.js) [data-map].is-drawn :global(.route) {
        animation-delay: 1120ms;
      }

      :global(.js) [data-map].is-drawn :global(.glow) {
        animation-delay: 1160ms;
      }

      :global(.js) [data-map].is-drawn :global(.label) {
        transition-delay: 980ms;
      }

      :global(.js) [data-map].is-drawn :global(.label) + :global(.label) {
        transition-delay: 1020ms;
      }

      :global(.js) [data-map].is-drawn :global(.here-label) {
        transition-delay: 1060ms;
      }
    }

    @keyframes map-pulse {
      from {
        transform: scale(1);
        opacity: 0.6;
      }
      to {
        transform: scale(1.35);
        opacity: 0;
      }
    }
  }
</style>

<script>
  // Pozoruje sa obal figúry, nie cesty — pozri poznámku v šablóne.
  const figure = document.querySelector<HTMLElement>('[data-map]');

  if (figure) {
    /*
      Zapečená vrstva štartuje na `opacity: 0` a s `loading="lazy"`. Prehliadač
      ju v tej kombinácii nezačne sťahovať sám — a keďže sa má práve odhaliť,
      pustíme ju tým istým signálom, ktorý spúšťa animáciu. Kto sekciu nikdy
      neuvidí, obrázok nestiahne.
    */
    const base = figure.querySelector<HTMLImageElement>('.map-base');

    const draw = () => {
      if (base) base.loading = 'eager';
      figure.classList.add('is-drawn');
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            draw();
          });
        },
        { threshold: 0.35 }
      );
      observer.observe(figure);
    } else {
      draw();
    }
  }
</script>
