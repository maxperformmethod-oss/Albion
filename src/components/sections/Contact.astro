---
import Section from '../ui/Section.astro';
import SectionTexture from '../ui/SectionTexture.astro';
import OpenState from '../ui/OpenState.astro';
import { addressWithPostalCode, business, isConfirmed, FEATURES } from '../../data/business.ts';
import { getContent } from '../../data/i18n.ts';
import { formatDays } from '../../lib/hours.ts';
import { phoneDisplayLong, phoneHref, buildCta } from '../../lib/cta.ts';

const content = getContent(Astro.currentLocale);
const { callAriaLabelLong } = buildCta(content);

const { id, h2, lead, labels } = content.contact;

const openingHours = isConfirmed(business.openingHours)
  ? business.openingHours
  : null;


const showDevBadge = import.meta.env.DEV && !phoneHref;
---

<Section
  tone="ink"
  id={id}
  labelledby="contact-title"
  class="relative overflow-hidden"
  innerClass="relative z-10"
>
  {/*
    Spodná tretina sekcie. Maska smerom nahor drží obraz mimo textu — pod
    kontaktnými údajmi nesmie vzniknúť nič, čo by zrážalo ich čitateľnosť.
  */}
  <div class="contact-texture" slot="backdrop">
    <SectionTexture texture="contact" sizes="100vw" />
  </div>

  <div class="measure">
    <h2 id="contact-title" class="font-serif text-h2" data-reveal>{h2}</h2>
    <p class="text-lead text-bone-muted mt-6" data-reveal>{lead}</p>
  </div>

  {
    FEATURES.hooks && (
      <p class="text-lead text-bone mt-8 max-w-[44ch]" data-reveal>
        {content.hooks.contact}
      </p>
    )
  }

  <dl class="mt-12 grid grid-cols-1 gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    {
      phoneHref && (
        <div class="border-hairline-dark border-t pt-6" data-reveal>
          <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
            {labels.phone}
          </dt>
          <dd class="mt-3">
            <a
              href={phoneHref}
              aria-label={callAriaLabelLong}
              class="font-serif text-h2 hover:text-gold transition-fast block leading-tight whitespace-nowrap"
              data-numeric
            >
              {phoneDisplayLong}
            </a>

            {/*
              Vykreslí sa až vtedy, keď je otvorené — mimo hodín nedáva
              zmysel a mätie. Stav zapisuje OpenState na <html>, takže tu
              stačí CSS a žiadny ďalší skript. Bez JS sa nezobrazí.
            */}
            {openingHours && (
              <p class="phone-note text-bone-muted text-small mt-3 max-w-[42ch]">
                {content.contact.phoneNote}
              </p>
            )}
          </dd>
        </div>
      )
    }

    {
      showDevBadge && (
        <div class="border-t border-red-600 pt-6">
          <p class="inline-block rounded-sm bg-red-600 px-2 py-1 text-[0.6875rem] font-bold tracking-wide text-white">
            {content.dev.missingPhoneBadge}
          </p>
        </div>
      )
    }

    <div class="border-hairline-dark border-t pt-6" data-reveal>
      <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
        {labels.address}
      </dt>
      <dd class="font-serif text-h3 mt-3">
        <address class="not-italic">{addressWithPostalCode}</address>
      </dd>
    </div>

    {
      openingHours && (
        <div class="border-hairline-dark border-t pt-6" data-reveal>
          <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
            {labels.hours}
          </dt>
          <dd class="mt-3">
            <ul class="flex flex-col gap-1">
              {openingHours.map((interval) => (
                <li class="flex gap-4" data-numeric>
                  <span class="text-bone-muted w-24 shrink-0">
                    {formatDays(interval.days)}
                  </span>
                  <span>
                    {interval.open} – {interval.close}
                  </span>
                </li>
              ))}
            </ul>
            <OpenState class="text-small mt-4" />
          </dd>
        </div>
      )
    }
  </dl>
</Section>

<style>
  .contact-texture {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    /* Spodná tretina — nad ňou musí ostať čistý podklad pre kontaktné údaje. */
    height: 34%;
    opacity: 0.35;
    -webkit-mask-image: linear-gradient(to top, black, transparent);
    mask-image: linear-gradient(to top, black, transparent);
    pointer-events: none;
  }

  .contact-texture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  /* Poznámka pri telefóne dáva zmysel len počas otváracích hodín. */
  .phone-note {
    display: none;
  }

  :global(html[data-open-state='open']) .phone-note {
    display: block;
  }
</style>
