---
import Section from '../ui/Section.astro';
import { business, isConfirmed } from '../../data/business.ts';
import { content } from '../../data/content.ts';
import { formatDays } from '../../lib/hours.ts';
import { phoneDisplay, phoneHref, callAriaLabel } from '../../lib/cta.ts';

const { id, h2, lead, labels, openNow, closedNow } = content.contact;

const street = isConfirmed(business.street) ? business.street : null;
const postalCode = isConfirmed(business.postalCode) ? business.postalCode : null;
const addressLine = street
  ? [street, [postalCode, business.city].filter(Boolean).join(' ')].join(', ')
  : content.footer.addressFallback;

const openingHours = isConfirmed(business.openingHours)
  ? business.openingHours
  : null;

const email = isConfirmed(business.email) ? business.email : null;

const showDevBadge = import.meta.env.DEV && !phoneHref;
---

<Section tone="ink" id={id} labelledby="contact-title">
  <div class="measure">
    <h2 id="contact-title" class="font-serif text-h2" data-reveal>{h2}</h2>
    <p class="text-lead text-bone-muted mt-6" data-reveal>{lead}</p>
  </div>

  <dl class="mt-14 grid grid-cols-1 gap-x-12 gap-y-10 sm:grid-cols-2">
    {
      phoneHref && (
        <div class="border-hairline-dark border-t pt-6" data-reveal>
          <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
            {labels.phone}
          </dt>
          <dd class="mt-3">
            <a
              href={phoneHref}
              aria-label={callAriaLabel}
              class="font-serif text-h3 hover:text-gold transition-fast"
              data-numeric
            >
              {phoneDisplay}
            </a>
          </dd>
        </div>
      )
    }

    {
      showDevBadge && (
        <div class="border-t border-red-600 pt-6">
          <p class="inline-block rounded-sm bg-red-600 px-2 py-1 text-[0.6875rem] font-bold tracking-wide text-white">
            {content.dev.missingPhoneBadge}
          </p>
        </div>
      )
    }

    <div class="border-hairline-dark border-t pt-6" data-reveal>
      <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
        {labels.address}
      </dt>
      <dd class="font-serif text-h3 mt-3">
        <address class="not-italic">{addressLine}</address>
      </dd>
    </div>

    {
      openingHours && (
        <div class="border-hairline-dark border-t pt-6" data-reveal>
          <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
            {labels.hours}
          </dt>
          <dd class="mt-3">
            <ul class="flex flex-col gap-1">
              {openingHours.map((interval) => (
                <li class="flex gap-4" data-numeric>
                  <span class="text-bone-muted w-24 shrink-0">
                    {formatDays(interval.days)}
                  </span>
                  <span>
                    {interval.open} – {interval.close}
                  </span>
                </li>
              ))}
            </ul>
            <span
              data-open-indicator
              data-hours={JSON.stringify(openingHours)}
              data-open-text={openNow}
              data-closed-text={closedNow}
              hidden
              class="text-small mt-4 inline-flex items-center gap-2"
            />
          </dd>
        </div>
      )
    }

    {
      email && (
        <div class="border-hairline-dark border-t pt-6" data-reveal>
          <dt class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
            {labels.email}
          </dt>
          <dd class="mt-3">
            <a
              href={`mailto:${email}`}
              class="font-serif text-h3 hover:text-gold transition-fast"
            >
              {email}
            </a>
          </dd>
        </div>
      )
    }
  </dl>
</Section>

<style>
  [data-open-indicator]::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  [data-open-indicator][data-state='open'] {
    color: var(--color-gold);
  }

  [data-open-indicator][data-state='closed'] {
    color: var(--color-bone-muted);
  }
</style>

<script>
  import { isOpenNow } from '../../lib/hours.ts';
  import type { OpeningInterval } from '../../data/business.ts';

  // Stav sa počíta na klientovi — statický build by ho zamrazil v čase buildu.
  const indicator = document.querySelector<HTMLElement>('[data-open-indicator]');

  if (indicator) {
    try {
      const intervals = JSON.parse(
        indicator.dataset.hours ?? '[]'
      ) as OpeningInterval[];
      const open = isOpenNow(intervals);

      indicator.textContent = open
        ? (indicator.dataset.openText ?? '')
        : (indicator.dataset.closedText ?? '');
      indicator.dataset.state = open ? 'open' : 'closed';
      indicator.hidden = false;
    } catch {
      // Radšej nič, ako nesprávny stav.
    }
  }
</script>
