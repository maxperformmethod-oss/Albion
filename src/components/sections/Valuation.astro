---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { content } from '../../data/content.ts';
import { phoneDisplay, primaryCta, hasPhone } from '../../lib/cta.ts';

const { id, eyebrow, h2, paragraphs, cta } = content.valuation;

// „Zavolať a opýtať sa“ dáva zmysel len s telefónom. Bez neho vedie CTA
// na kontakt a nesie znenie primárneho CTA.
const ctaText = hasPhone ? cta : primaryCta.text;

// Prístupný názov musí obsahovať viditeľný text (WCAG 2.5.3), preto sa skladá
// z vlastného znenia tlačidla, nie zo všeobecného „Zavolať na číslo …“.
const ctaLabel =
  hasPhone && phoneDisplay
    ? content.a11y.callAriaLabelWithAction
        .replace('{action}', ctaText)
        .replace('{phone}', phoneDisplay)
    : primaryCta.label;
---

<Section tone="ink" id={id} labelledby="valuation-title">
  <div class="measure">
    <Eyebrow data-reveal>{eyebrow}</Eyebrow>

    <h2 id="valuation-title" class="font-serif text-h2 mt-6" data-reveal>{h2}</h2>

    {
      paragraphs.map((paragraph) => (
        <p class="text-bone-muted mt-6" data-reveal>
          {paragraph}
        </p>
      ))
    }

    <div class="mt-10" data-reveal>
      <Button
        href={primaryCta.href}
        icon={primaryCta.icon}
        label={ctaLabel}
      >
        {ctaText}
      </Button>
    </div>
  </div>
</Section>
