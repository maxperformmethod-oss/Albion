---
import Section from '../ui/Section.astro';
import SectionTexture from '../ui/SectionTexture.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getContent } from '../../data/i18n.ts';
import { hasPhone, buildCta } from '../../lib/cta.ts';

const content = getContent(Astro.currentLocale);
const { primaryCta } = buildCta(content);

const { id, eyebrow, h2, paragraphs, cta } = content.valuation;

// „Zavolať a opýtať sa“ dáva zmysel len s telefónom. Bez neho vedie CTA
// na kontakt a nesie znenie primárneho CTA.
// Prístupný názov si Button poskladá sám z tohto znenia a z čísla.
const ctaText = hasPhone ? cta : primaryCta.text;
---

<Section
  tone="ink"
  id={id}
  labelledby="valuation-title"
  class="relative overflow-hidden"
>
  {/*
    Pravých 42 % zaberá obraz, text drží ľavých 58 %. Predtým tu bola prázdna
    pravá polovica, čo nepôsobilo vzdušne, ale nedokončene. Pod `lg` sa panel
    nevykresľuje vôbec — na úzkom displeji by z neho ostal len pruh.

    Od dávky 22 je tu makro záber prsteňov namiesto zlatého saténu. Je to
    POZADIE, nie ponuka: obraz je generovaný, takže nesmie nikde vyzerať ako
    tovar, ktorý máme na sklade. Preto ostáva pod maskou a krytím a nikdy
    nejde do sekcie predaja.
  */}
  <div class="valuation-panel" slot="backdrop">
    <SectionTexture texture="rings" sizes="(min-width: 1024px) 42vw, 0px" />
  </div>

  <div class="measure relative z-10 lg:max-w-[58%]">
    <Eyebrow data-reveal>{eyebrow}</Eyebrow>

    <h2 id="valuation-title" class="font-serif text-h2 mt-6" data-reveal>{h2}</h2>

    {
      paragraphs.map((paragraph) => (
        <p class="text-bone-muted mt-6" data-reveal>
          {paragraph}
        </p>
      ))
    }

    <div class="mt-10" data-reveal>
      <Button
        href={primaryCta.href}
        icon={primaryCta.icon}
        phone={primaryCta.phone}
      >
        {ctaText}
      </Button>
    </div>
  </div>
</Section>

<style>
  .valuation-panel {
    display: none;
  }

  @media (width >= 64rem) {
    .valuation-panel {
      display: block;
      position: absolute;
      inset-block: 0;
      right: 0;
      width: 42%;
      /*
        Mäkký okraj, aby panel nemal viditeľnú zvislú hranu. Fade začína skôr
        (30 %) než pri zlatom saténe (40 %) — makro fotka má ostrú kresbu
        a potrebuje dlhší nábeh, aby nemala čitateľný obrys.

        Krytie znížené z 0,85 na 0,45 (docs/PROMPT_FINAL22.md §4). Satén bol
        abstraktný a 0,85 uniesol; prstene pri tom istom krytí čítali ako
        produktová fotka tovaru na predaj, čo §2 výslovne zakazuje, a ťahali
        pozornosť z nadpisu. Pri 0,45 ostáva z obrazu hĺbka, nie ponuka.
      */
      -webkit-mask-image: linear-gradient(to left, black 30%, transparent);
      mask-image: linear-gradient(to left, black 30%, transparent);
      opacity: 0.45;
      pointer-events: none;
    }

    .valuation-panel :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center right;
    }
  }
</style>
