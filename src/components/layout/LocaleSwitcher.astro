---
import {
  ENABLED_LOCALES,
  LOCALES,
  LOCALE_SWITCHER,
  ROUTES,
  getLocale,
  routeKeyOf,
} from '../../data/i18n.ts';

/**
 * Prepínač jazykov.
 *
 * Aktívny jazyk je tmavá pilulka, neaktívny holý text. Podoba sa prepína
 * jedným riadkom v `i18n.ts` (`LOCALE_SWITCHER.style`), bez zásahu sem.
 *
 * Pri vlajkách: **inline SVG, nie emoji** — emoji vlajky sa na Windowse
 * nevykreslia a zostane z nich `SK` v obdĺžniku. Vlajka je `aria-hidden`
 * a kód jazyka pri nej zostáva; samotná vlajka nie je pre čítačku
 * jednoznačná ani prístupná. `aria-label` nesie plný názov jazyka.
 *
 * Prepnutie vedie na tú istú stránku v druhom jazyku, nie na domovskú.
 */
interface Props {
  variant?: 'header' | 'menu';
}

const { variant = 'header' } = Astro.props;

const current = getLocale(Astro.currentLocale);
const routeKey = routeKeyOf(Astro.url.pathname);
const showFlags = LOCALE_SWITCHER.style === 'flags';

/** Vlajky sú zjednodušené na tri/dva pruhy — v 18 × 12 px viac nevidno. */
const FLAGS = {
  sk: '<rect width="18" height="4" fill="#fff"/><rect y="4" width="18" height="4" fill="#0b4ea2"/><rect y="8" width="18" height="4" fill="#ee1c25"/>',
  hu: '<rect width="18" height="4" fill="#cd2a3e"/><rect y="4" width="18" height="4" fill="#fff"/><rect y="8" width="18" height="4" fill="#436f4d"/>',
  en: '<rect width="18" height="12" fill="#012169"/><path d="M0 0l18 12M18 0L0 12" stroke="#fff" stroke-width="2.4"/><path d="M9 0v12M0 6h18" stroke="#fff" stroke-width="4"/><path d="M9 0v12M0 6h18" stroke="#c8102e" stroke-width="2.4"/>',
};
---

<nav
  aria-label={LOCALES[current].label}
  class:list={['locale-switcher', variant === 'menu' && 'locale-switcher--menu']}
>
  {
    ENABLED_LOCALES.map((code) => (
      <a
        href={ROUTES[routeKey][code]}
        hreflang={LOCALES[code].htmlLang}
        aria-label={LOCALES[code].label}
        aria-current={code === current ? 'true' : undefined}
        class:list={['locale', code === current && 'is-current']}
      >
        {showFlags && (
          <svg
            class="flag"
            viewBox="0 0 18 12"
            width="18"
            height="12"
            aria-hidden="true"
            set:html={FLAGS[code]}
          />
        )}
        <span>{LOCALES[code].short}</span>
      </a>
    ))
  }
</nav>

<style>
  .locale-switcher {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .locale {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding-inline: 10px;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    color: var(--color-bone-muted);
    transition:
      color var(--duration-fast) var(--ease-out-quint),
      background-color var(--duration-fast) var(--ease-out-quint);
    /* Tap target 48 × 48 px cez neviditeľné odsadenie, nie cez väčšiu pilulku. */
    position: relative;
  }

  .locale::after {
    content: '';
    position: absolute;
    inset: -10px -2px;
    min-height: 48px;
  }

  .locale:hover {
    color: var(--color-gold);
  }

  .locale.is-current {
    background-color: var(--color-ink-700);
    color: var(--color-bone);
  }

  /* Hranica, aby svetlé vlajky nesplynuli s podkladom. */
  .flag {
    display: block;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
  }

  .locale-switcher--menu {
    border-top: 1px solid var(--color-hairline-dark);
    padding-top: 0.75rem;
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }
</style>
