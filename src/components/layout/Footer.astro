---
import Logo from '../brand/Logo.astro';
import { addressWithPostalCode, business, isConfirmed } from '../../data/business.ts';
import { content } from '../../data/content.ts';
import { phoneDisplayLong, phoneHref, callAriaLabelLong } from '../../lib/cta.ts';

const year = new Date().getFullYear();

const legalName = isConfirmed(business.legalName) ? business.legalName : null;
// V pätičke IČO s medzerami, v JSON-LD bez nich.
const ico = isConfirmed(business.icoDisplay) ? business.icoDisplay : null;
const legalLine =
  legalName && ico
    ? content.footer.legal.replace('{legalName}', legalName).replace('{ico}', ico)
    : null;

const email = isConfirmed(business.email) ? business.email : null;
---

<footer class="border-hairline-dark bg-ink-900 text-bone border-t">
  <div class="container-page py-14">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div>
        <Logo variant="full" class="text-[1.3rem]" />

        <address class="text-bone-muted text-small mt-6 not-italic">
          <span class="block">{addressWithPostalCode}</span>
          {
            phoneHref && (
              <a
                href={phoneHref}
                aria-label={callAriaLabelLong}
                class="hover:text-gold transition-fast mt-1 block"
                data-numeric
              >
                {phoneDisplayLong}
              </a>
            )
          }
          {
            email && (
              <a
                href={`mailto:${email}`}
                class="hover:text-gold transition-fast mt-1 block"
              >
                {email}
              </a>
            )
          }
        </address>
      </div>

      <nav aria-label={content.footer.quickLinksHeading}>
        <h2 class="font-sans text-eyebrow text-gold uppercase tracking-[0.14em]">
          {content.footer.quickLinksHeading}
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            content.header.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-bone-muted hover:text-bone transition-fast text-small"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="border-hairline-dark text-bone-muted mt-12 flex flex-col gap-4 border-t pt-6 text-[0.8125rem] md:flex-row md:items-start md:justify-between"
    >
      <div class="flex flex-col gap-1">
        <p>{content.footer.copyright.replace('{year}', String(year))}</p>
        {legalLine && <p>{legalLine}</p>}
      </div>

      {/*
        Vizuálne slabšie než hlavné odkazy — je to povinná agenda, nie
        navigácia, ktorou chceme niekoho viesť.
      */}
      <nav aria-label={content.legal.footerHeading} class="flex flex-wrap gap-x-5 gap-y-1">
        <a href={content.legal.privacy.slug} class="hover:text-bone transition-fast">
          {content.legal.privacy.title}
        </a>
        <a href={content.legal.terms.slug} class="hover:text-bone transition-fast">
          {content.legal.terms.title}
        </a>
      </nav>
    </div>
  </div>
</footer>
