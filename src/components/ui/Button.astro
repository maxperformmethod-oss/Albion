---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { getContent } from '../../data/i18n.ts';

const content = getContent(Astro.currentLocale);

/**
 * CTA hierarchia z BRIEF §8:
 *   primary → „Zavolať“ (tel:)
 *   ghost   → „Chcem oceniť vec“ (#kontakt), hranica border-interactive-*
 *   link    → „Otvoriť v Google Mapách“, textový odkaz
 *
 * Tap target min 48×48 px (BRIEF §9). Rádius 3 px, žiadne pill tvary.
 */
interface Props {
  variant?: 'primary' | 'ghost' | 'link';
  tone?: 'dark' | 'light';
  href?: string;
  type?: 'button' | 'submit';
  icon?: IconName;
  /**
   * `true` — vždy len ikona.
   * `'below-480'` — pod 480 px len ikona, nad ňou ikona + text (BRIEF §9).
   * Oboje vyžaduje `label`.
   */
  iconOnly?: boolean | 'below-480';
  /**
   * Číslo do prístupného názvu telefónneho CTA. Skladanie názvu robí tlačidlo,
   * nie miesto použitia — WCAG 2.5.3 (Label in Name) sa nám takto porušiť nedá.
   * Pozri poznámku nižšie.
   */
  phone?: string | null;
  /** aria-label pre ostatné prípady — povinný pri `iconOnly`. */
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  tone = 'dark',
  href,
  type = 'button',
  icon,
  iconOnly = false,
  phone,
  label,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

/*
  WCAG 2.5.3 Label in Name: prístupný názov musí obsahovať viditeľný text,
  inak sa hlasové ovládanie rozíde s tým, čo užívateľ vidí. Predtým sa názov
  skladal na troch miestach použitia a zakaždým trochu inak. Tu ho tlačidlo
  poskladá zo svojho vlastného viditeľného textu, takže to nemôže vyjsť zle.
*/
const slotHtml = Astro.slots.has('default')
  ? await Astro.slots.render('default')
  : '';

const visibleText =
  iconOnly === true
    ? ''
    : slotHtml
        .replace(/<[^>]*>/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

const ariaLabel = phone
  ? visibleText
    ? content.a11y.callAriaLabelWithAction
        .replace('{action}', visibleText)
        .replace('{phone}', phone)
    : content.a11y.callAriaLabel.replace('{phone}', phone)
  : label;

// Poistka pre `label` odovzdaný zvonku. Neprejde do produkcie, len upozorní.
if (
  import.meta.env.DEV &&
  ariaLabel &&
  visibleText &&
  !ariaLabel.toLowerCase().includes(visibleText.toLowerCase())
) {
  console.warn(
    `[Button] WCAG 2.5.3: aria-label „${ariaLabel}“ neobsahuje viditeľný text „${visibleText}“.`
  );
}

const base =
  'inline-flex items-center justify-center gap-2.5 font-sans text-small font-semibold whitespace-nowrap transition-fast';

const shapes = {
  primary: 'min-h-12 rounded-sm px-6',
  ghost: 'min-h-12 rounded-sm border px-6',
  link: 'min-h-12 underline underline-offset-4 decoration-1',
};

const skins = {
  primary: {
    dark: 'bg-gold text-ink-900 hover:bg-gold-hover',
    light: 'bg-gold text-ink-text hover:bg-gold-hover',
  },
  ghost: {
    // hover na tmavom ide na zlatú (8,39:1); na svetlom na gold-ink (4,95:1),
    // pretože zlatá na paper má 2,02:1 a ako hranica by spadla pod 3:1.
    dark: 'border-border-interactive-dark text-bone hover:border-gold hover:text-gold',
    light:
      'border-border-interactive-light text-ink-text hover:border-gold-ink hover:text-gold-ink',
  },
  link: {
    dark: 'text-gold hover:text-gold-hover',
    light: 'text-gold-ink hover:text-ink-text',
  },
} as const;

const shape =
  iconOnly === true
    ? 'h-12 w-12 min-h-12 shrink-0 rounded-sm px-0'
    : iconOnly === 'below-480'
      ? 'h-12 w-12 min-h-12 shrink-0 rounded-sm px-0 min-[480px]:w-auto min-[480px]:px-6'
      : shapes[variant];

const needsBorder = iconOnly && variant === 'ghost' ? 'border' : null;
---

<Tag
  href={href}
  type={href ? undefined : type}
  aria-label={ariaLabel}
  class:list={[base, shape, needsBorder, skins[variant][tone], className]}
  {...rest}
>
  {icon && <Icon name={icon} size={iconOnly ? 22 : 18} />}
  {
    iconOnly !== true && (
      <span
        class:list={[iconOnly === 'below-480' && 'hidden min-[480px]:inline']}
        set:html={slotHtml}
      />
    )
  }
</Tag>
