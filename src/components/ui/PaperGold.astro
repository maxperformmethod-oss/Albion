---
import SectionTexture from './SectionTexture.astro';

interface Props {
  /** Jedno slovo v pozadí. Dekorácia, nie obsah. */
  word?: string;
}

const { word } = Astro.props;

/**
 * Veľmi tlmené zlaté teplo v pravom hornom rohu svetlej sekcie.
 *
 * Cieľ je, aby si to vedome nevšimol a len ti tá plocha prišla teplejšia.
 * Preto krytie 0,07, `multiply` a maska bez viditeľnej hrany — ak by to čo
 * i len trochu pôsobilo ako škvrna, treba znížiť krytie, nie zväčšiť efekt.
 *
 * Je len na dvoch sekciách („Čo u nás môžete založiť alebo predať“ a „Ako to
 * funguje“) a na právnych stránkach nie je vôbec.
 *
 * Kontrast `--color-ink-text` v mieste, kde je zlato najsilnejšie, je meraný —
 * pozri `docs/REPORT_faza18.md`. Text má vždy prednosť pred textúrou.
 */
---

{word && <span class="ghost-word" aria-hidden="true">{word}</span>}

<div class="paper-gold" data-paper-gold aria-hidden="true">
  <SectionTexture texture="gold-light" sizes="(min-width: 640px) 55vw, 80vw" />
</div>

<style>
  /*
    Duchové slovo. Orezané okrajom sekcie, krytie 0,035 — kontrast textu nad
    ním sa meria, pozri docs/REPORT_faza20.md.
  */
  .ghost-word {
    position: absolute;
    bottom: -0.18em;
    left: -0.04em;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(8rem, 22vw, 18rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--color-ink-text);
    /* 0,02: na paper-2 bolo pri 0,035 spolu so zlatom 11,41:1. */
    opacity: 0.02;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  .paper-gold {
    position: absolute;
    top: 0;
    right: 0;
    width: 55%;
    height: 100%;
    /* 0,05 namiesto 0,07: na paper-2 klesol kontrast ink-text na 11,41:1. */
    opacity: 0.04;
    mix-blend-mode: multiply;
    pointer-events: none;
    /* Bez `-webkit-` sa maska na starších iOS neuplatní a vznikne ostrý blok. */
    -webkit-mask-image: radial-gradient(
      ellipse at top right,
      black 0%,
      transparent 70%
    );
    mask-image: radial-gradient(ellipse at top right, black 0%, transparent 70%);
    /* §4.2 — pomalý posun svetla naviazaný na scroll. Len `translate3d`. */
    transform: translate3d(0, var(--paper-shift, 0px), 0);
    will-change: auto;
  }

  .paper-gold :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top right;
  }
</style>

<script>
  /*
    Veľmi pomalý posun svetla naviazaný na scroll. Nie je to parallax obsahu —
    oko to nezachytí vedome, len plocha prestane byť mŕtva.

    Počíta sa cez IntersectionObserver + requestAnimationFrame, nie cez
    neškrtený scroll listener, a mení sa výhradne .
  */
  const layers = document.querySelectorAll<HTMLElement>('[data-paper-gold]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (layers.length > 0 && !still && 'IntersectionObserver' in window) {
    const range = window.matchMedia('(width < 48rem)').matches ? 20 : 40;
    const active = new Set<HTMLElement>();
    let ticking = false;

    const update = () => {
      ticking = false;
      for (const layer of active) {
        const section = layer.parentElement;
        if (!section) continue;
        const rect = section.getBoundingClientRect();
        const progress = Math.min(
          1,
          Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight + rect.height))
        );
        layer.style.setProperty(
          '--paper-shift',
          `${((progress - 0.5) * range).toFixed(1)}px`
        );
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const layer = entry.target as HTMLElement;
        if (entry.isIntersecting) active.add(layer);
        else active.delete(layer);
      });
      if (active.size > 0) onScroll();
    });

    layers.forEach((layer) => observer.observe(layer));
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
