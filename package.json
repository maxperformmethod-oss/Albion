{
  "name": "albion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-placeholders.mjs --pre && astro build && node scripts/check-placeholders.mjs --post",
